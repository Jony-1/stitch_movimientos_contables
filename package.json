    "build:web": "astro build",
    "preview:web": "astro preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
