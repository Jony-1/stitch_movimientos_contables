{
  "name": "stitch-movimientos-contables",
  "version": "1.0.0",
  "description": "Backend sencillo para movimientos contables",
  "main": "server.js",
  "scripts": {
    "prestart": "npm run build:web",
    "start": "node server.js",
    "dev:api": "nodemon server.js",
    "dev:web": "astro dev",
