---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Reportes" active="reportes" name="Usuario" role="Productor" email="user@demo.com">
  <div class="mx-auto flex max-w-7xl flex-col gap-6">
    <section class="surface-card overflow-hidden rounded-3xl p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Análisis de movimientos y facturas</p>
          <h1 class="mt-2 text-4xl font-black leading-tight text-slate-900 dark:text-white">Reportes financieros</h1>
          <p class="mt-2 text-slate-500 dark:text-slate-400">Ingresos, gastos, facturas y tendencia del ciclo en una sola vista.</p>
          <p id="reports-status" class="mt-3 text-sm text-slate-500 dark:text-slate-400"></p>
        </div>

        <div class="flex flex-wrap gap-3">
          <button id="report-export-csv" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
            <span class="material-symbols-outlined text-base">download</span>
            Exportar CSV
          </button>
          <button id="report-export-pdf" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary/90">
            <span class="material-symbols-outlined text-base">picture_as_pdf</span>
            Exportar PDF
          </button>
          <button id="report-apply" type="button" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
            <span class="material-symbols-outlined text-base">autorenew</span>
            Aplicar filtros
          </button>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2 rounded-2xl bg-slate-100 p-2 dark:bg-slate-800/80">
        <button data-report-range="all" type="button" class="surface-chip bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white">Todo</button>
        <button data-report-range="30d" type="button" class="surface-chip text-slate-600 hover:bg-white hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700">Últimos 30 días</button>
        <button data-report-range="month" type="button" class="surface-chip text-slate-600 hover:bg-white hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700">Este mes</button>
        <button data-report-range="year" type="button" class="surface-chip text-slate-600 hover:bg-white hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700">Este año</button>
      </div>

      <div class="mt-5 grid gap-4 lg:grid-cols-4">
        <label class="surface-muted flex flex-col gap-2 p-4">
          <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Tipo de movimiento</span>
          <select id="report-type" class="surface-input h-11 px-3 text-sm text-slate-900 dark:text-white">
            <option value="all">Todos</option>
            <option value="ingreso">Ingresos</option>
            <option value="gasto">Gastos</option>
          </select>
        </label>

        <label class="surface-muted flex flex-col gap-2 p-4">
          <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Desde</span>
          <input id="report-from" type="date" class="surface-input h-11 px-3 text-sm text-slate-900 dark:text-white" />
        </label>

        <label class="surface-muted flex flex-col gap-2 p-4">
          <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Hasta</span>
          <input id="report-to" type="date" class="surface-input h-11 px-3 text-sm text-slate-900 dark:text-white" />
        </label>

        <div class="surface-muted flex flex-col justify-end p-4">
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Rango aplicado</p>
          <p id="reports-period-label" class="mt-1 text-sm text-slate-500 dark:text-slate-400">Todo el historial</p>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-6">
      <article id="report-card-income" class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Ingresos</p>
        <p id="report-ingresos" class="mt-2 text-3xl font-black text-emerald-600">$0</p>
      </article>
      <article class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Gastos</p>
        <p id="report-gastos" class="mt-2 text-3xl font-black text-rose-600">$0</p>
      </article>
      <article class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Balance</p>
        <p id="report-resultado" class="mt-2 text-3xl font-black text-slate-900 dark:text-white">$0</p>
      </article>
      <article class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Movimientos</p>
        <p id="report-count" class="mt-2 text-3xl font-black text-slate-900 dark:text-white">0</p>
      </article>
      <article class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Facturas</p>
        <p id="report-invoice-count" class="mt-2 text-3xl font-black text-slate-900 dark:text-white">0</p>
      </article>
      <article class="surface-card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Pendientes</p>
        <p id="report-invoice-pending" class="mt-2 text-3xl font-black text-amber-600">$0</p>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Desglose por categoría</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Movimientos agrupados por categoría.</p>
          </div>
        </div>
        <div id="report-category-list" class="grid gap-3"></div>
      </div>

      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Tendencia mensual</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Ingresos y gastos por mes.</p>
          </div>
        </div>
        <div id="report-month-list" class="grid gap-3"></div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Facturas por estado</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Distribución del monto por estado.</p>
          </div>
          <span id="report-invoice-total" class="text-sm font-semibold text-slate-500 dark:text-slate-400"></span>
        </div>
        <div id="report-invoice-status-list" class="grid gap-3"></div>
      </div>

      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Facturas por contraparte</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Clientes o proveedores con mayor valor.</p>
          </div>
        </div>
        <div id="report-invoice-party-list" class="grid gap-3"></div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Movimientos incluidos</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Detalle de los registros que alimentan el reporte.</p>
          </div>
          <span id="report-movement-count" class="text-sm font-semibold text-slate-500 dark:text-slate-400"></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-50 dark:bg-slate-900/40">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Fecha</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Descripción</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Tipo</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Categoría</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Monto</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estado</th>
              </tr>
            </thead>
            <tbody id="report-movements-tbody" class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>

      <div class="surface-card p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Facturas incluidas</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Detalle de facturas dentro del rango aplicado.</p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-50 dark:bg-slate-900/40">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Número</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Contraparte</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Fecha</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Vencimiento</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Monto</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estado</th>
              </tr>
            </thead>
            <tbody id="report-invoices-tbody" class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <script type="module">
    import { initReportsPage } from "../scripts/reports-page.js";
    initReportsPage();
  </script>
</AppLayout>
