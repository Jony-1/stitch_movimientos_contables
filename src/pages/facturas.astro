---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Facturas" active="facturas" name="Miembro" role="Gestión" email="usuario@stitch.local">
  <style>
    #invoices-table thead,
    #invoices-table thead tr,
    #invoices-table thead th,
    #invoices-table tbody td:last-child,
    #invoices-table thead th:last-child {
      position: static !important;
      z-index: auto !important;
    }

    #invoices-table th,
    #invoices-table td,
    #invoices-table button {
      pointer-events: auto;
    }

    #modal-invoice,
    #modal-invoice-action {
      z-index: 9999;
    }
  </style>

  <div class="mx-auto flex max-w-7xl flex-col gap-6">
    <section class="surface-card rounded-3xl p-6 sm:p-8">
      <div class="flex flex-wrap items-end gap-4 justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Ventas y cuentas</p>
          <h1 class="text-4xl font-black text-slate-900 dark:text-white">Facturas</h1>
          <p class="text-slate-500 dark:text-slate-400">Consulta, filtra y actualiza facturas sin perder contexto.</p>
          <p id="invoices-active-organization" class="mt-2 text-sm font-semibold text-primary dark:text-primary/90"></p>
          <p id="invoices-status" class="mt-2 text-sm text-slate-500 dark:text-slate-400"></p>
        </div>
        <button id="btn-new-invoice" class="flex min-w-[160px] items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary/90">
          <span class="material-symbols-outlined text-base">add</span>
          <span class="truncate">Nueva Factura</span>
        </button>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-6 xl:grid-cols-5">
      <article class="surface-card p-6 xl:col-span-3">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Urgencia de cartera</p>
            <h2 id="invoices-priority-title" class="mt-2 text-3xl font-black text-slate-900 dark:text-white">Analizando prioridades...</h2>
            <p id="invoices-priority-summary" class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">Calculando qué facturas requieren atención inmediata.</p>
          </div>
          <div class="rounded-2xl bg-slate-50 px-4 py-4 text-right dark:bg-slate-900/40">
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Cartera pendiente</p>
            <p id="invoices-priority-pending" class="mt-2 text-2xl font-black text-amber-600">$0</p>
          </div>
        </div>
      </article>

      <article class="surface-card p-6 xl:col-span-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Acción recomendada</h2>
        <p id="invoices-next-action" class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">Selecciona una factura o revisa las vencidas para ver la recomendación operativa más relevante.</p>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="surface-card p-5">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Vencidas</p>
        <p id="invoice-kpi-overdue-count" class="mt-2 text-3xl font-black text-rose-600">0</p>
        <p id="invoice-kpi-overdue-amount" class="mt-1 text-sm text-slate-500 dark:text-slate-400">$0</p>
      </article>
      <article class="surface-card p-5">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Por cobrar</p>
        <p id="invoice-kpi-pending-amount" class="mt-2 text-3xl font-black text-amber-600">$0</p>
        <p id="invoice-kpi-pending-count" class="mt-1 text-sm text-slate-500 dark:text-slate-400">0 facturas</p>
      </article>
      <article class="surface-card p-5">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Vence en 7 días</p>
        <p id="invoice-kpi-due-soon-count" class="mt-2 text-3xl font-black text-amber-500">0</p>
        <p id="invoice-kpi-due-soon-amount" class="mt-1 text-sm text-slate-500 dark:text-slate-400">$0</p>
      </article>
      <article class="surface-card p-5">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Cobranza efectiva</p>
        <p id="invoice-kpi-paid-rate" class="mt-2 text-3xl font-black text-emerald-600">0%</p>
        <p id="invoice-kpi-paid-amount" class="mt-1 text-sm text-slate-500 dark:text-slate-400">$0</p>
      </article>
    </section>

    <section class="surface-card p-4 sm:p-6">
      <div class="flex flex-wrap items-end gap-4">
          <div class="flex flex-col">
            <p class="pb-2 text-sm font-medium leading-normal text-gray-900 dark:text-white">Filtrar por estado</p>
            <div class="flex gap-2 rounded-lg bg-slate-100 p-1 dark:bg-slate-800">
              <button data-invoice-filter="all" class="surface-chip bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white">Todos</button>
              <button data-invoice-filter="pagada" class="surface-chip text-slate-500 hover:bg-white dark:text-slate-400 dark:hover:bg-slate-700">Pagada</button>
              <button data-invoice-filter="pending" class="surface-chip text-slate-500 hover:bg-white dark:text-slate-400 dark:hover:bg-slate-700">Pendiente</button>
              <button data-invoice-filter="vencida" class="surface-chip text-slate-500 hover:bg-white dark:text-slate-400 dark:hover:bg-slate-700">Vencida</button>
              <button data-invoice-filter="due-soon" class="surface-chip text-slate-500 hover:bg-white dark:text-slate-400 dark:hover:bg-slate-700">Vence 7 dias</button>
              <button data-invoice-filter="high-amount" class="surface-chip text-slate-500 hover:bg-white dark:text-slate-400 dark:hover:bg-slate-700">Alto monto</button>
            </div>
          </div>
      </div>
    </section>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
      <section class="surface-card min-w-0 xl:col-span-2 overflow-hidden">
        <div class="min-w-0 overflow-x-auto">
          <table id="invoices-table" class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-900">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Número</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Contraparte</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Emisión</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Vencimiento</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Monto</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Estado</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300"></th>
              </tr>
            </thead>
            <tbody id="invoices-tbody" class="divide-y divide-gray-200 dark:divide-gray-800"></tbody>
          </table>
        </div>
      </section>

      <section id="invoice-detail" class="surface-card min-w-0 xl:sticky xl:top-6 xl:self-start p-6">
        <h2 class="mb-4 text-lg font-bold text-gray-900 dark:text-white">Detalle de factura</h2>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p id="invoice-number" class="text-2xl font-bold text-gray-900 dark:text-white">Selecciona una factura</p>
            <p id="invoice-party" class="text-gray-500 dark:text-gray-400">El detalle aparecerá aquí.</p>
          </div>
          <div class="flex flex-col items-end gap-2">
            <span id="invoice-status" class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200"></span>
            <button id="invoice-edit" type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
              <span class="material-symbols-outlined text-base">edit</span>
              Editar
            </button>
            <button id="invoice-pay" type="button" class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-700">
              <span class="material-symbols-outlined text-base">payments</span>
              Marcar pagada
            </button>
            <button id="invoice-print" type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
              <span class="material-symbols-outlined text-base">picture_as_pdf</span>
              PDF
            </button>
          </div>
        </div>
        <div class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
          <div class="space-y-1 rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40"><p class="text-gray-500 dark:text-gray-400">Fecha de emisión</p><p id="invoice-issue-date" class="font-medium text-gray-800 dark:text-gray-200">—</p></div>
          <div class="space-y-1 rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40"><p class="text-gray-500 dark:text-gray-400">Fecha de vencimiento</p><p id="invoice-due-date" class="font-medium text-gray-800 dark:text-gray-200">—</p></div>
          <div class="space-y-1 rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40"><p class="text-gray-500 dark:text-gray-400">Monto</p><p id="invoice-total" class="font-medium text-gray-800 dark:text-gray-200">—</p></div>
          <div class="space-y-1 rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40"><p class="text-gray-500 dark:text-gray-400">Número interno</p><p id="invoice-id" class="font-medium text-gray-800 dark:text-gray-200">—</p></div>
        </div>
        <div class="mt-6 border-t border-slate-200 pt-5 dark:border-slate-800">
          <div class="mb-3 flex items-center justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Ítems</p>
              <p id="invoice-items-count" class="text-sm font-medium text-slate-600 dark:text-slate-300"></p>
            </div>
          </div>
          <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                <tr>
                  <th class="px-4 py-3">Descripción</th>
                  <th class="px-4 py-3 text-right">Cantidad</th>
                  <th class="px-4 py-3 text-right">Precio</th>
                  <th class="px-4 py-3 text-right">Total</th>
                </tr>
              </thead>
              <tbody id="invoice-items-tbody" class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
            </table>
          </div>
          <p id="invoice-items-empty" class="mt-3 text-sm text-slate-500 dark:text-slate-400"></p>
        </div>
        <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">Desde aquí puedes revisar, editar o borrar facturas sin salir de la pantalla.</p>
      </section>
    </div>
  </div>

  <div id="modal-invoice" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity" aria-hidden="true">
    <div class="absolute inset-0 bg-black/40" data-modal-close></div>
    <div class="relative w-full max-w-3xl p-4">
      <div class="surface-card max-h-[calc(100vh-2rem)] overflow-y-auto rounded-xl p-6">
        <div class="mb-4 flex items-start justify-between">
          <h2 id="invoice-modal-title" class="text-lg font-bold text-gray-900 dark:text-white">Nueva factura</h2>
          <button data-modal-close class="text-gray-500 hover:text-gray-900 dark:hover:text-white"><span class="material-symbols-outlined">close</span></button>
        </div>
        <form id="invoice-form" class="space-y-4">
          <div><label class="text-sm font-medium">Número</label><input id="inv-number" class="surface-input w-full py-2" required /></div>
          <div><label class="text-sm font-medium">Proveedor/Comprador</label><input id="inv-party" class="surface-input w-full py-2" required /></div>
          <div class="grid grid-cols-2 gap-4"><div><label class="text-sm font-medium">Fecha</label><input id="inv-date" type="date" class="surface-input w-full py-2" /></div><div><label class="text-sm font-medium">Vencimiento</label><input id="inv-due" type="date" class="surface-input w-full py-2" /></div></div>
          <div><label class="text-sm font-medium">Monto total</label><input id="inv-amount" type="number" class="surface-input w-full py-2" readonly placeholder="Se calcula con los ítems" /></div>
          <div><label class="text-sm font-medium">Estado</label><select id="inv-status" class="surface-input w-full py-2"><option value="pending">Pendiente</option><option value="pagada">Pagada</option><option value="vencida">Vencida</option></select></div>
          <div class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900/40">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">Ítems de la factura</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">Agrega conceptos y el total se calcula solo.</p>
              </div>
              <button id="invoice-add-item" type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800">
                <span class="material-symbols-outlined text-base">add</span>
                Agregar ítem
              </button>
            </div>
            <div id="invoice-items-list" class="space-y-3"></div>
            <div class="flex items-center justify-between rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white">
              <span>Total calculado</span>
              <span id="invoice-total-preview">$0</span>
            </div>
          </div>
          <div class="flex justify-end gap-3 pt-2"><p id="invoice-form-status" class="mr-auto self-center text-sm text-slate-500 dark:text-slate-400"></p><button type="button" data-modal-close class="rounded-lg bg-gray-100 px-4 py-2 dark:bg-gray-800 dark:text-gray-200">Cancelar</button><button id="invoice-submit" type="submit" class="rounded-lg bg-primary px-4 py-2 font-bold text-white hover:bg-primary/90">Guardar</button></div>
        </form>
      </div>
    </div>
  </div>

  <div id="modal-invoice-action" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity" aria-hidden="true">
    <div class="absolute inset-0 bg-black/50" data-invoice-action-close></div>
    <div class="relative w-full max-w-md p-4">
      <div class="surface-card rounded-2xl p-6 shadow-2xl">
        <div class="mb-4 flex items-start justify-between gap-4">
          <div>
            <p id="invoice-action-title" class="text-lg font-bold text-gray-900 dark:text-white">Confirmar acción</p>
            <p id="invoice-action-message" class="mt-2 text-sm text-slate-500 dark:text-slate-400"></p>
          </div>
          <button type="button" data-invoice-action-close class="text-gray-500 hover:text-gray-900 dark:hover:text-white"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="flex justify-end gap-3">
          <button id="invoice-action-cancel" type="button" class="rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold dark:bg-gray-800 dark:text-gray-200">Cancelar</button>
          <button id="invoice-action-confirm" type="button" class="rounded-lg px-4 py-2 text-sm font-semibold text-white"></button>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    import { initInvoicesPage } from "../scripts/invoices-page.js?v=17";
    const boot = () => initInvoicesPage();
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) window.location.reload();
    });
  </script>
</AppLayout>
