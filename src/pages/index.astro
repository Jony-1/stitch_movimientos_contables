---
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <Head title="Stitch | Plataforma financiera agroempresarial" />
  </head>
  <body class="min-h-screen font-display text-slate-900 antialiased dark:text-slate-100">
    <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-6 py-6 sm:px-8 lg:px-10">
      <header class="flex items-center justify-between gap-4 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-sm font-black tracking-[0.2em] text-white shadow-lg shadow-primary/20">ST</div>
          <div>
            <p class="text-lg font-black tracking-[-0.03em]">Stitch</p>
            <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Plataforma financiera agroempresarial</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            data-theme-toggle
            class="flex h-11 items-center gap-2 rounded-full border border-slate-200 bg-white/90 px-3 text-slate-600 shadow-sm transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
            aria-label="Cambiar tema"
            aria-pressed="false"
            title="Cambiar tema"
          >
            <span class="material-symbols-outlined text-2xl" data-theme-icon>dark_mode</span>
            <span class="hidden text-sm font-semibold sm:inline" data-theme-label>Modo noche</span>
          </button>
          <a href="/login" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Iniciar sesión</a>
          <a href="/register" class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90 dark:shadow-primary/10">Crear cuenta</a>
        </div>
      </header>

      <section class="grid flex-1 items-center gap-10 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:py-16">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/85 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-900/85 dark:text-slate-200">
            <span class="inline-block size-2 rounded-full bg-emerald-500"></span>
            Gestión financiera de operaciones agrícolas
          </div>
          <h1 class="mt-6 text-5xl font-black tracking-[-0.05em] text-slate-950 sm:text-6xl dark:text-white">
            Visibilidad diaria de caja, cartera y operación para grupos agrícolas.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
            Centralice movimientos, facturas y reportes por empresa en un solo entorno operativo.
            Tome decisiones con contexto financiero, prioridades claras y seguimiento permanente.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#experiencia" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-950/20 transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:shadow-slate-100/20 dark:hover:bg-slate-200">
              <span class="material-symbols-outlined text-base">insights</span>
              Conocer la plataforma
            </a>
            <a href="/login" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
              <span class="material-symbols-outlined text-base">login</span>
              Iniciar sesion
            </a>
            <a href="/register" class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-5 py-3 text-sm font-semibold text-primary transition-colors hover:bg-primary/15 dark:border-primary/30 dark:bg-primary/20 dark:hover:bg-primary/25">
              <span class="material-symbols-outlined text-base">person_add</span>
              Solicitar acceso
            </a>
          </div>
          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            <article class="rounded-3xl border border-white/80 bg-white/80 p-5 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/80">
              <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Empresas activas</p>
              <p class="mt-2 text-3xl font-black text-slate-950 dark:text-white">3</p>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Gestionadas desde un unico panel operativo.</p>
            </article>
            <article class="rounded-3xl border border-white/80 bg-white/80 p-5 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/80">
              <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Alertas operativas</p>
              <p class="mt-2 text-3xl font-black text-slate-950 dark:text-white">8</p>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Facturas vencidas, riesgo de caja y focos de gasto.</p>
            </article>
            <article class="rounded-3xl border border-white/80 bg-white/80 p-5 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/80">
              <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Pronóstico</p>
              <p class="mt-2 text-3xl font-black text-slate-950 dark:text-white">30d</p>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Proyeccion de caja simple, clara y explicable.</p>
            </article>
          </div>
        </div>

        <div id="experiencia" class="relative">
          <div class="absolute -left-8 -top-8 h-24 w-24 rounded-full bg-emerald-400/20 blur-2xl"></div>
          <div class="absolute -bottom-10 -right-6 h-24 w-24 rounded-full bg-sky-400/20 blur-2xl"></div>
          <section class="relative overflow-hidden rounded-[2rem] border border-white/80 bg-white/90 p-6 shadow-[0_30px_80px_rgba(15,23,42,0.16)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
            <div class="flex items-center justify-between gap-4 border-b border-slate-200 pb-4 dark:border-slate-800">
              <div>
                <p class="text-xs uppercase tracking-[0.25em] text-slate-500">Empresa activa</p>
                <p class="mt-1 text-lg font-bold text-slate-950 dark:text-white">Agro Norte SAS</p>
              </div>
              <div class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Saludable</div>
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
              <article class="rounded-3xl bg-slate-950 p-5 text-white shadow-lg shadow-slate-950/20 dark:bg-slate-100 dark:text-slate-950">
                <p class="text-xs uppercase tracking-[0.25em] text-white/70 dark:text-slate-500">Índice financiero</p>
                <div class="mt-4 flex items-end justify-between gap-4">
                  <div>
                    <p class="text-5xl font-black tracking-[-0.05em]">78</p>
                    <p class="mt-2 text-sm text-white/70 dark:text-slate-500">La operación es estable, aunque conviene vigilar cartera y concentración de gastos.</p>
                  </div>
                  <div class="rounded-2xl bg-white/10 px-4 py-3 text-right dark:bg-slate-900/10">
                    <p class="text-xs uppercase tracking-[0.18em] text-white/60 dark:text-slate-500">Caja 30 días</p>
                    <p class="mt-2 text-2xl font-black">$ 10.5M</p>
                  </div>
                </div>
              </article>

              <div class="grid gap-4">
                <article class="rounded-3xl border border-rose-200 bg-rose-50 p-5 dark:border-rose-900/40 dark:bg-rose-950/20">
                  <p class="text-xs uppercase tracking-[0.2em] text-rose-600 dark:text-rose-300">Alerta prioritaria</p>
                  <p class="mt-2 text-base font-bold text-rose-900 dark:text-rose-100">3 facturas vencidas impactan el flujo de caja.</p>
                  <p class="mt-2 text-sm text-rose-700 dark:text-rose-300">Prioriza cobro hoy para reducir presion operativa.</p>
                </article>
                <div class="grid grid-cols-2 gap-4">
                  <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/40">
                  <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Pendiente por cobrar</p>
                  <p class="mt-3 text-2xl font-black text-amber-600">$ 14M</p>
                </article>
                  <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/40">
                    <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Balance actual</p>
                    <p class="mt-3 text-2xl font-black text-slate-950 dark:text-white">$ 32M</p>
                  </article>
                </div>
              </div>
            </div>
          </section>
        </div>
      </section>

      <section class="grid gap-5 pb-10 md:grid-cols-3">
        <article class="rounded-[2rem] border border-white/80 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
          <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Problema</p>
          <h2 class="mt-3 text-2xl font-black text-slate-950 dark:text-white">La caja se fragmenta entre empresas, facturas y planillas.</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">Stitch unifica operacion, cartera y movimientos para grupos agricolas, contratistas y administraciones que necesitan una vista accionable del dia.</p>
        </article>
        <article class="rounded-[2rem] border border-white/80 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
          <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Como funciona</p>
          <ul class="mt-4 grid gap-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
            <li>1. Cambias de empresa activa sin perder contexto.</li>
            <li>2. Registras movimientos y facturas por operacion.</li>
            <li>3. El sistema destaca riesgos y prioridades de operación.</li>
          </ul>
        </article>
        <article class="rounded-[2rem] border border-white/80 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
          <p class="text-xs uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Cierre</p>
          <h2 class="mt-3 text-2xl font-black text-slate-950 dark:text-white">Menos dispersión operativa. Más control financiero.</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">Administre la operación diaria y convierta información financiera en decisiones concretas para dirección, cartera y tesorería.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/register" class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90 dark:shadow-primary/10">Solicitar acceso</a>
            <a href="/login" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Ya tengo acceso</a>
          </div>
        </article>
      </section>
    </main>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var buttons = document.querySelectorAll("[data-theme-toggle]");

        function currentTheme() {
          return document.documentElement.classList.contains("dark") ? "dark" : "light";
        }

        function syncThemeButton(button, theme) {
          var icon = button.querySelector("[data-theme-icon]");
          var label = button.querySelector("[data-theme-label]");
          var nextTheme = theme === "dark" ? "light" : "dark";

          button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
          button.setAttribute("aria-label", theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo noche");
          button.setAttribute("title", theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo noche");

          if (icon) icon.textContent = theme === "dark" ? "light_mode" : "dark_mode";
          if (label) label.textContent = theme === "dark" ? "Modo claro" : "Modo noche";

          button.dataset.nextTheme = nextTheme;
        }

        function syncTheme(theme) {
          buttons.forEach(function (button) {
            syncThemeButton(button, theme);
          });
        }

        syncTheme(currentTheme());

        buttons.forEach(function (button) {
          button.addEventListener("click", function () {
            var nextTheme = button.dataset.nextTheme || (currentTheme() === "dark" ? "light" : "dark");
            if (window.StitchTheme && typeof window.StitchTheme.apply === "function") {
              window.StitchTheme.apply(nextTheme, true);
            }
            syncTheme(nextTheme);
          });
        });

        window.addEventListener("stitch-theme-change", function (event) {
          syncTheme((event && event.detail && event.detail.theme) || currentTheme());
        });
      });
    </script>
  </body>
</html>
