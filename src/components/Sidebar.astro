---
const { active = "dashboard" } = Astro.props;

const links = [
  { href: "/dashboard", label: "Inicio", icon: "home", key: "dashboard" },
  { href: "/movimientos", label: "Movimientos", icon: "potted_plant", key: "movimientos" },
  { href: "/facturas", label: "Facturas", icon: "receipt_long", key: "facturas" },
  { href: "/reportes", label: "Reportes", icon: "bar_chart", key: "reportes" },
  { href: "/configuraciones", label: "Configuración", icon: "settings", key: "configuraciones", adminOnly: true },
  { href: "/usuarios", label: "Usuarios", icon: "group", key: "usuarios", adminOnly: true },
];
---

<aside class="flex h-screen w-72 flex-col justify-between p-4">
  <div class="flex flex-col gap-8">
    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-white shadow-sm">
        <span class="text-sm font-black tracking-[0.2em]">AG</span>
      </div>
      <div>
        <h1 class="text-lg font-black tracking-[-0.03em] text-slate-900 dark:text-slate-100">AgroSostenible</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">Panel contable</p>
        <p data-sidebar-organization class="mt-1 text-[11px] font-semibold text-primary dark:text-primary/90">Sin empresa activa</p>
      </div>
    </div>

    <nav class="flex flex-col gap-2">
      {links.map((link) => (
        <a
          data-admin-only={link.adminOnly ? "true" : undefined}
          class={`flex items-center gap-3 rounded-2xl px-3 py-3 transition-all ${active === link.key ? "bg-primary text-white shadow-lg shadow-primary/20" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800/70 dark:hover:text-white"}`}
          href={link.href}
        >
          <span class="material-symbols-outlined text-2xl">{link.icon}</span>
          <p class="text-sm font-semibold">{link.label}</p>
        </a>
      ))}
    </nav>
  </div>

  <div class="flex flex-col gap-1 pt-4">
    <a class="flex items-center gap-3 rounded-2xl px-3 py-3 text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-slate-300 dark:hover:bg-red-950/40 dark:hover:text-red-300" href="/logout" data-logout-link>
      <span class="material-symbols-outlined text-2xl">logout</span>
      <p class="text-sm font-medium">Cerrar Sesión</p>
    </a>
  </div>
</aside>
