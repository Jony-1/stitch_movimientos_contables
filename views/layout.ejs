<!DOCTYPE html>
<html class="light" lang="es">

<head>
    <%- include("partials/head", { title }) %>
</head>

<body class="font-display bg-background-light dark:bg-background-dark">
    <div class="flex min-h-screen w-full">
        <!-- Mobile overlay when sidebar is open -->
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity duration-300" data-sidebar-close></div>
        
        <!-- Sidebar - fixed on mobile, static on desktop -->
        <aside id="sidebar-container" class="fixed md:static top-0 left-0 z-50 w-64 h-screen md:h-auto transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out overflow-y-auto md:overflow-y-visible">
            <%- include("partials/sidebar", { active }) %>
        </aside>

        <!-- Main content -->
        <main class="flex-1 flex flex-col w-full min-w-0 overflow-hidden">
            <!-- Header with hamburger -->
            <div class="flex items-center h-16 border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 sticky top-0 z-30 flex-shrink-0">
                <button id="sidebar-toggle" class="md:hidden p-4 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex-shrink-0" title="Abrir menu">
                    <span class="material-symbols-outlined text-2xl">menu</span>
                </button>
                <div id="app-header" class="flex-1 px-2 sm:px-4 min-w-0 overflow-hidden"></div>
            </div>

            <!-- Page content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-10 w-full">
                <%- body %>
            </div>
        </main>
    </div>

    <%- include("partials/scripts") %>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var toggle = document.getElementById('sidebar-toggle');
            var container = document.getElementById('sidebar-container');
            var overlay = document.getElementById('sidebar-overlay');
            
            if (!container || !overlay) return;
            
            function openSidebar() {
                container.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            }
            
            function closeSidebar() {
                container.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
            
            // Show hamburger only on mobile
            if (toggle) {
                toggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (container.classList.contains('-translate-x-full')) {
                        openSidebar();
                    } else {
                        closeSidebar();
                    }
                });
            }
            
            overlay.addEventListener('click', closeSidebar);
            
            // Close sidebar when nav link clicked
            var navLinks = container.querySelectorAll('a[href], button');
            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 768) {
                        setTimeout(closeSidebar, 100);
                    }
                });
            });
            
            // Handle resize - close sidebar on resize to desktop
            var resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    if (window.innerWidth >= 768) {
                        closeSidebar();
                    }
                }, 250);
            });
        });
    </script>
</body>

</html>
