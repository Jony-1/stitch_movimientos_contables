<%- include("layout", { title: "Dashboard" , active: "dashboard" , body: ` <main class="flex-1 p-8 overflow-y-auto">
    <div id="app-header"></div>

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
            <h1 class="text-gray-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
                Movimientos de Cultivo
            </h1>

            <!-- ✅ Lo dejamos como estaba: tu JS ya detecta el texto "nuevo movimiento" -->
            <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary/90">
                <span class="material-symbols-outlined" style="font-size: 20px;">add</span>
                <span class="truncate">Nuevo movimiento</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <div
                class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-900">
                        <tr>
                            <th
                                class="px-4 py-3 text-left text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Fecha</th>
                            <th
                                class="px-4 py-3 text-left text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Tipo</th>
                            <th
                                class="px-4 py-3 text-left text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Categoría</th>
                            <th
                                class="px-4 py-3 text-left text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Descripción</th>
                            <th
                                class="px-4 py-3 text-right text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Monto</th>
                            <th
                                class="px-4 py-3 text-left text-gray-600 dark:text-gray-300 text-xs font-semibold uppercase tracking-wider">
                                Estado</th>
                        </tr>
                    </thead>

                    <!-- ✅ quitamos el id roto "id" -->
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                        <!-- filas demo (puedes borrarlas si ya llenas desde API) -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </main>

    <!-- ✅ MODAL -->
    <div class="fixed inset-0 bg-gray-900 bg-opacity-50 dark:bg-opacity-80 flex items-center justify-center z-50 transition-opacity opacity-0 pointer-events-none"
        id="new-movement-modal" role="dialog" aria-hidden="true">
        <div
            class="bg-white dark:bg-gray-900 rounded-xl shadow-xl w-full max-w-lg m-4 transform scale-95 transition-transform">

            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">Registrar Nuevo Movimiento</h2>

                <!-- ✅ ahora sí cierra -->
                <button type="button" data-modal-close
                    class="text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6">
                <!-- ✅ el form ahora se usa con submit -->
                <form class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                            for="date">Fecha</label>
                        <input
                            class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary focus:ring-primary sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-200"
                            id="date" name="date" type="date" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Tipo</label>
                        <div class="mt-2 flex gap-4">
                            <label class="flex items-center">
                                <input checked
                                    class="form-radio h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:border-gray-600 dark:bg-gray-800"
                                    name="type" type="radio" value="ingreso" />
                                <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Ingreso</span>
                            </label>
                            <label class="flex items-center">
                                <input
                                    class="form-radio h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:border-gray-600 dark:bg-gray-800"
                                    name="type" type="radio" value="gasto" />
                                <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Gasto</span>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                            for="category">Categoría</label>
                        <select
                            class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary focus:ring-primary sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-200"
                            id="category" name="category">
                            <option>Venta de papa</option>
                            <option>Semillas</option>
                            <option>Abonos</option>
                            <option>Mano de obra</option>
                            <option>Combustible</option>
                            <option>Arriendo de maquinaria</option>
                            <option>Transporte</option>
                            <option>Otros</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                            for="description">Descripción</label>
                        <textarea
                            class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-primary focus:ring-primary sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-200"
                            id="description" name="description" placeholder="Ej: Venta de 20 bultos de papa R12"
                            rows="3"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                            for="amount">Monto</label>
                        <div class="relative mt-1 rounded-lg shadow-sm">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                <span class="text-gray-500 dark:text-gray-400 sm:text-sm">$</span>
                            </div>
                            <input
                                class="block w-full rounded-lg border-gray-300 dark:border-gray-600 pl-7 pr-12 focus:border-primary focus:ring-primary sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-200"
                                id="amount" name="amount" placeholder="0.00" type="number" />
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                                <span class="text-gray-500 dark:text-gray-400 sm:text-sm" id="currency">COP</span>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ botones dentro del form para que submit funcione -->
                    <div class="pt-2 flex justify-end gap-3">
                        <button
                            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-600 text-sm font-bold leading-normal tracking-[0.015em] hover:bg-gray-100 dark:hover:bg-gray-600"
                            type="button" data-modal-close>
                            <span class="truncate">Cancelar</span>
                        </button>

                        <!-- ✅ submit -->
                        <button
                            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary/90"
                            type="submit">
                            <span class="truncate">Guardar</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    `
    }) %>