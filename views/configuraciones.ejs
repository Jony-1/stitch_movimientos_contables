<%- include("layout", { title: "Dashboard" , active: "dashboard" , body: ` <main class="flex flex-1 flex-col">
    <!-- Placeholder para header compartido -->
    <div id="app-header"></div>
    <div class="flex flex-1 flex-col gap-6 p-8">
        <div class="max-w-4xl mx-auto w-full">
            <header>
                <p class="text-gray-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
                    Configuración</p>
            </header>
            <div class="flex flex-col gap-10 mt-6">
                <section
                    class="bg-white dark:bg-gray-900/50 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <h3 class="text-gray-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em] mb-6">
                        Datos de la unidad productiva</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <label class="flex flex-col">
                            <p class="text-gray-800 dark:text-gray-200 text-sm font-medium leading-normal pb-2">Nombre
                                del productor / finca</p>
                            <input
                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-gray-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 focus:border-primary h-12 placeholder:text-gray-500 dark:placeholder:text-gray-400 px-4 text-base font-normal leading-normal"
                                value="Familia Pérez Rojas" />
                        </label>
                        <label class="flex flex-col">
                            <p class="text-gray-800 dark:text-gray-200 text-sm font-medium leading-normal pb-2">
                                Identificación (C.C. / NIT)</p>
                            <div class="flex w-full flex-1 items-stretch rounded-lg">
                                <input
                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-gray-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 focus:border-primary h-12 placeholder:text-gray-500 dark:placeholder:text-gray-400 px-4 text-base font-normal leading-normal"
                                    value="1.234.567.890" />
                            </div>
                        </label>
                        <label class="flex flex-col">
                            <p class="text-gray-800 dark:text-gray-200 text-sm font-medium leading-normal pb-2">Moneda
                            </p>
                            <input
                                class="form-input cursor-not-allowed flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-gray-500 dark:text-gray-400 focus:outline-0 focus:ring-0 border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 h-12 px-4 text-base font-normal leading-normal"
                                disabled value="Peso Colombiano (COP)" />
                        </label>
                    </div>
                    <div class="mt-8 flex justify-end">
                        <button
                            class="flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap rounded-lg bg-primary px-5 py-2.5 text-center text-sm font-semibold text-white transition-all duration-300 ease-in-out hover:bg-primary/90">Guardar
                            Cambios</button>
                    </div>
                </section>
                <!-- Sección: Gestión de usuarios -->
                <section id="users-section"
                    class="bg-white dark:bg-gray-900/50 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <h3
                                class="text-gray-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">
                                Gestión de Usuarios</h3>
                            <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Aquí puedes crear, editar o
                                eliminar usuarios del sistema.</p>
                        </div>
                        <button id="btn-new-user"
                            class="flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap rounded-lg border border-primary bg-primary/10 dark:bg-primary/20 px-4 py-2 text-center text-sm font-semibold text-primary transition-all duration-300 ease-in-out hover:bg-primary/20">
                            <span class="material-symbols-outlined text-lg">add</span>
                            <span>Nuevo Usuario</span>
                        </button>
                    </div>
                    <div id="users-management" class="mt-4">
                        <!-- El contenido de la tabla de usuarios será renderizado por js/app.js -->
                        <div id="users-requests" class="mb-6"></div>
                        <div id="users-table-container"></div>
                    </div>
                </section>
                <section
                    class="bg-white dark:bg-gray-900/50 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <h3
                                class="text-gray-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">
                                Categorías de Ingresos y Gastos</h3>
                            <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Organiza los movimientos de tu
                                cultivo.</p>
                        </div>
                        <button
                            class="flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap rounded-lg border border-primary bg-primary/10 dark:bg-primary/20 px-4 py-2 text-center text-sm font-semibold text-primary dark:text-primary-300 transition-all duration-300 ease-in-out hover:bg-primary/20 dark:hover:bg-primary/30">
                            <span class="material-symbols-outlined text-lg">add</span>
                            <span>Nueva Categoría</span>
                        </button>
                    </div>
                    <div class="mt-6 flow-root">
                        <ul class="divide-y divide-gray-200 dark:divide-gray-800" role="list">
                            <li class="py-3 sm:py-4 group">
                                <div class="flex items-center space-x-4">
                                    <div class="flex-shrink-0"><span
                                            class="material-symbols-outlined text-green-600 dark:text-green-500 bg-green-100 dark:bg-green-900/50 p-2 rounded-full">arrow_upward</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-900 dark:text-white truncate">Venta de
                                            cosecha</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400 truncate">Ingreso</p>
                                    </div>
                                    <div
                                        class="inline-flex items-center text-base font-semibold text-gray-900 dark:text-white opacity-0 group-hover:opacity-100 transition-opacity duration-200 gap-2">
                                        <button class="p-2 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800"><span
                                                class="material-symbols-outlined text-gray-500 dark:text-gray-400 text-xl">edit</span></button>
                                        <button class="p-2 rounded-md hover:bg-red-50 dark:hover:bg-red-900/50"><span
                                                class="material-symbols-outlined text-red-600 dark:text-red-500 text-xl">delete</span></button>
                                    </div>
                                </div>
                            </li>
                            <!-- otras categorías... -->
                        </ul>
                    </div>
                </section>
            </div>
        </div>
    </div>
    </main>



    <!-- Modal: Nuevo Usuario -->
    <div id="modal-user" aria-hidden="true"
        class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none opacity-0 transition-opacity">
        <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
        <div class="relative w-full max-w-xl p-4">
            <div
                class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-6 shadow-lg transform scale-95 transition-transform">
                <h3 class="text-lg font-bold mb-4">Nuevo usuario</h3>
                <form id="form-user" class="space-y-4">
                    <div>
                        <label class="text-sm font-medium">Nombre</label>
                        <input id="user-name" class="form-input w-full rounded-lg border px-3 py-2" required />
                    </div>
                    <div>
                        <label class="text-sm font-medium">Correo</label>
                        <input id="user-email" type="email" class="form-input w-full rounded-lg border px-3 py-2"
                            required />
                    </div>
                    <div>
                        <label class="text-sm font-medium">Rol</label>
                        <select id="user-role" class="form-input w-full rounded-lg border px-3 py-2">
                            <option>Productor</option>
                            <option>Admin</option>
                            <option>Contador</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-4">
                        <label class="inline-flex items-center gap-2"><input id="user-active" type="checkbox" checked />
                            Activo</label>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button id="user-cancel" class="px-4 py-2 rounded-lg bg-gray-100">Cancelar</button>
                        <button id="user-save" class="px-4 py-2 rounded-lg bg-primary text-white">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    `
    }) %>